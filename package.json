{
  "name": "buntysajji",
  "version": "2.0.0",
  "private": true,
  "description": "Bunty Sajji restaurant ordering and admin system",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "lint": "eslint .",
