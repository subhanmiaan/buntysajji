# Server-side only. Never copy this file into a public web folder.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
# Legacy SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are also supported.
APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Set only to the verified number of reverse proxies on your hosting platform.
TRUST_PROXY_HOPS=0
